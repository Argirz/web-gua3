* text=auto eol=lf

# Binary: jangan konversi line-ending (pernah merusak JPG/PNG)
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.gif binary
*.svg text eol=lf
*.mp4 binary
*.woff binary
*.woff2 binary
*.pdf binary

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
